# ---- Secrets: never commit --------------------------------------------
initial-passwords.txt
*.pem
*.key

# ---- Runtime state ----------------------------------------------------
# Everything under docker-data/ is generated at runtime: mailboxes, account
# databases (password hashes), DKIM private keys, TLS certificates, the
# Roundcube webroot and its SQLite database. None of it belongs in git.
docker-data/*
certs/*
backups/

# Keep the empty directories so the bind mounts resolve on a fresh clone.
!docker-data/.gitkeep
!certs/.gitkeep

# ---- Local overrides --------------------------------------------------
.env.local
*.local

# ---- OS / editor ------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
