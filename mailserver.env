# docker-mailserver configuration
# Full reference: https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# -----------------------------------------------
# --- General -----------------------------------
# -----------------------------------------------
OVERRIDE_HOSTNAME=
LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=
# Accounts are stored in docker-data/dms/config/postfix-accounts.cf
ACCOUNT_PROVISIONER=FILE
PERMIT_DOCKER=none
TZ=Europe/Amsterdam
NETWORK_INTERFACE=
ENABLE_AMAVIS=0
ENABLE_DNSBL=0
# Rspamd handles DKIM signing, DMARC and SPF checks (recommended).
# Do not enable OpenDKIM/OpenDMARC/policyd-spf at the same time.
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_POP3=0
ENABLE_IMAP=1
ENABLE_CLAMAV=0
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_LEARN=1
RSPAMD_GREYLISTING=1
RSPAMD_HFILTER=1
ENABLE_FAIL2BAN=1
ENABLE_MANAGESIEVE=1
POSTMASTER_ADDRESS=postmaster@gsit.nl
ENABLE_UPDATE_CHECK=1
UPDATE_CHECK_INTERVAL=1d

# -----------------------------------------------
# --- Spam / virus ------------------------------
# -----------------------------------------------
MOVE_SPAM_TO_JUNK=1
MARK_SPAM_AS_READ=0
SPOOF_PROTECTION=1

# -----------------------------------------------
# --- TLS ---------------------------------------
# -----------------------------------------------
# self-signed (generated by ./setup.sh) for local/testing.
# Switch to `letsencrypt` in production (see docs/DNS-SETUP.md).
SSL_TYPE=self-signed
TLS_LEVEL=modern

# -----------------------------------------------
# --- Delivery / relay --------------------------
# -----------------------------------------------
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
POSTFIX_MAILBOX_SIZE_LIMIT=0
ENABLE_QUOTAS=1
# Optional smarthost (set all three to relay outbound mail via a provider):
# RELAY_HOST=
# RELAY_PORT=587
# RELAY_USER=
# RELAY_PASSWORD=

# -----------------------------------------------
# --- Sieve / forwarding ------------------------
# -----------------------------------------------
SIEVE_SPAM_FOLDER=Junk

# -----------------------------------------------
# --- Misc --------------------------------------
# -----------------------------------------------
POSTSCREEN_ACTION=enforce
SMTP_ONLY=
ONE_DIR=1
